{
  "name": "madara-py-ide",
  "version": "1.0.0",
  "private": true,
  "description": "Madara PyIDE — a VS Code style Python IDE for Android, running Python offline with Pyodide.",
  "scripts": {
    "dev": "node scripts/copy-pyodide.mjs && vite",
    "build": "node scripts/copy-pyodide.mjs && vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "monaco-editor": "^0.57.0",
    "pyodide": "^314.0.7"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  },
  "type": "module"
}
